# Server Configuration
PORT=3000
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_long_random_secret
# Required for production. Example: postgresql://erp_user:strong_password@localhost:5432/erp_nexus
DATABASE_URL=
# Comma-separated web origins allowed to call the API and WebSocket server.
APP_ORIGIN=http://localhost:3000
# Demo seed data is useful only on a new local database.
SEED_DEMO_DATA=true
# Gives a biometric gateway permission to submit signed device events. Never expose to browsers.
BIOMETRIC_GATEWAY_KEY=replace_with_a_long_random_gateway_key

# Google Gemini AI API (Optional, server-side context engine)
GEMINI_API_KEY=
